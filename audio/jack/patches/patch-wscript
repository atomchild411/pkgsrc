+    if conf.env['IS_NETBSD']:
+        conf.env.append_unique('CXXFLAGS', '-D_NETBSD_SOURCE')
+
     if not conf.env['IS_MACOSX']:
         conf.env.append_unique('LDFLAGS', '-Wl,--no-undefined')
     else:
@@ -546,6 +554,9 @@
