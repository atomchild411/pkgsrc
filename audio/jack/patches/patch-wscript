- Add NetBSD support.
- Ensure man pages are installed on all Unixes.
- IRIX: the NetBSD port without its Sun audio driver, CAS via __sync.

--- wscript.orig
+++ wscript
@@ -216,6 +216,7 @@
         ('IS_LINUX',   'Linux',   ['gnu0', 'gnukfreebsd', 'linux', 'posix']),
         ('IS_FREEBSD', 'FreeBSD', ['freebsd']),
         ('IS_MACOSX',  'MacOS X', ['darwin']),
+        ('IS_NETBSD',  'NetBSD',  ['netbsd', 'irix']),
         ('IS_SUN',     'SunOS',   ['sunos']),
         ('IS_WINDOWS', 'Windows', ['cygwin', 'msys', 'win32'])
     ]
@@ -231,6 +232,8 @@
                 conf.env[key] = True
                 conf.end_msg(name, color='CYAN')
                 break
+    # IRIX builds the NetBSD port's POSIX parts, without its Sun audio
+    conf.env['IS_IRIX'] = platform.startswith('irix')
 
 
 def configure(conf):
@@ -258,6 +261,11 @@
         conf.check(lib='execinfo', uselib='EXECINFO', define_name='EXECINFO')
         conf.check_cfg(package='libsysinfo', args='--cflags --libs')
 
