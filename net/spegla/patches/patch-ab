IRIX: use statvfs, like Solaris and NetBSD.

--- spegla.c.orig
+++ spegla.c
@@ -33,7 +33,7 @@
 #ifdef MTYPES
 #include "missing/defs.h"
 #endif
-#ifdef Solaris
+#if defined(Solaris) || defined(__sgi)
 #include <sys/statvfs.h>
 #endif
 #ifdef LINUX
@@ -708,7 +708,7 @@
 #ifdef ULTRIX
 	struct	fs_data f;
 #else
-#ifdef Solaris
+#if defined(Solaris) || (defined(__NetBSD__) && __NetBSD_Version__ >= 299000900) || defined(__sgi)
 	struct	statvfs f;
 #else
 	struct	statfs f;
@@ -718,7 +718,7 @@
 	if (minfree == 0)
 		return;
 
-#ifdef Solaris
+#if defined(Solaris) || (defined(__NetBSD__) && __NetBSD_Version__ >= 299000900) || defined(__sgi)
 	if (statvfs(path, &f) < 0)
 		e_err(1, "statvfs: %s", path);
 #else
