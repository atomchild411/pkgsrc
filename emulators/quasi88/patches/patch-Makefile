* Build with SDL.
Link libm, which the sound code (exp) needs where SDL does not bring it.

--- Makefile.orig
+++ Makefile
@@ -16,8 +16,8 @@
 #	GTK版の場合は、「GTK_VERSION」以外の行をコメントアウトしてください。
 #	( GTK版は実験中です。GTK版でサウンドを鳴らすには、SDL が必要です )
 
-X11_VERSION	= 1
-# SDL_VERSION	= 1
+# X11_VERSION	= 1
+SDL_VERSION	= 1
 # GTK_VERSION	= 1
 
 
@@ -940,7 +940,7 @@
 		-mkdir $@
 
 $(PROGRAM):	$(OBJECTS)
-		$(LD) $(OBJECTS) $(LIBS) -o $(PROGRAM) 
+		$(LD) $(OBJECTS) $(LIBS) -lm -o $(PROGRAM) 
 
 
 $(OBJDIR)/$(SNDDRV_DIR)/%.o: $(SRCDIR)/$(SNDDRV_DIR)/%.c
