# $NetBSD$
#
# IRIX republish rounds (included by bsd.pkg.mk on IRIX).
#
# A toolchain fix changes the code of every package without changing any
# version, so pkgin would not bring the rebuilt packages to installed systems
# (and a CDN that caches package files as immutable could keep the old ones).
# Each word in IRIX_REPUBLISH_ROUNDS (mk/platform/IRIX.mk) raises every IRIX
# package's PKGREVISION by one. Rounds are only ever added, never removed:
# removing one would make every version go backwards.
#
# bmake has no arithmetic: _IRIX_NEXT.N is N+1 for 0 to 999; a larger revision
# (some packages use a date) gets its last digit raised, and the few that end
# in 9 stay as they are.

.for _irix_round_ in ${IRIX_REPUBLISH_ROUNDS}
_IRIX_REV_:=	${PKGREVISION:U0}
.  if empty(_IRIX_REV_)
_IRIX_REV_:=	0
.  endif
.  if defined(_IRIX_NEXT.${_IRIX_REV_})
PKGREVISION:=	${_IRIX_NEXT.${_IRIX_REV_}}
.  else
PKGREVISION:=	${_IRIX_REV_:C/8$/9/:C/7$/8/:C/6$/7/:C/5$/6/:C/4$/5/:C/3$/4/:C/2$/3/:C/1$/2/:C/0$/1/}
.  endif
.endfor

