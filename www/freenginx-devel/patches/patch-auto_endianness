$NetBSD$

Cross builds (NGX_CROSS=yes): no test programs run.

--- auto/endianness.orig
+++ auto/endianness
@@ -32,7 +32,16 @@
 eval "$ngx_test >> $NGX_AUTOCONF_ERR 2>&1"
 
 if [ -x $NGX_AUTOTEST ]; then
-    if $NGX_AUTOTEST >/dev/null 2>&1; then
+    if [ "$NGX_CROSS" = yes ]; then
+        # cross builds: the compiler knows the target's byte order
+        ngx_le=`$CC -dM -E -x c /dev/null 2>/dev/null \
+                | grep -c "__BYTE_ORDER__ __ORDER_LITTLE_ENDIAN__"`
+    elif $NGX_AUTOTEST >/dev/null 2>&1; then
+        ngx_le=1
+    else
+        ngx_le=0
+    fi
+    if [ "$ngx_le" = 1 ]; then
         echo " little endian"
         have=NGX_HAVE_LITTLE_ENDIAN . auto/have
     else
