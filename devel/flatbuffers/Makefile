# $NetBSD: Makefile,v 1.9 2026/02/28 02:08:52 ryoon Exp $

DISTNAME=	flatbuffers-25.12.19-2026-02-06-03fffb2
PKGNAME=	flatbuffers-25.12.19.1
CATEGORIES=	devel
MASTER_SITES=	${MASTER_SITE_GITHUB:=google/}
GITHUB_TAG=	v25.12.19-2026-02-06-03fffb2

MAINTAINER=	minskim@NetBSD.org
HOMEPAGE=	https://flatbuffers.dev/
COMMENT=	Memory efficient serialization library
LICENSE=	apache-2.0

USE_CMAKE=	yes
USE_LANGUAGES=	c c++

CMAKE_CONFIGURE_ARGS+=	-DCMAKE_BUILD_TYPE=Release
CMAKE_CONFIGURE_ARGS+=	-DFLATBUFFERS_BUILD_SHAREDLIB=ON
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_POLICY_VERSION_MINIMUM=3.5

.include "../../mk/bsd.prefs.mk"

# The tests' headers are generated by running the flatc just built, which a
# cross build cannot; they are not installed.
.if ${USE_CROSS_COMPILE:tl} == "yes"
CMAKE_CONFIGURE_ARGS+=	-DFLATBUFFERS_BUILD_TESTS=OFF
.endif

USE_CXX_FEATURES+=	c++11

BUILDLINK_TRANSFORM+=	rm:-Werror

.include "../../mk/bsd.pkg.mk"
