$NetBSD: patch-ad,v 1.16 2016/02/15 11:42:11 jperkin Exp $

Cross builds: run the tests that have no cache variable anyway. The
program cannot run, and the answer that gives is the right one for IRIX
(no extra ANSI flags, POSIX trylock and timedwait, SysV poll values).

--- configure.orig
+++ configure
@@ -26,7 +26,7 @@
 #
 GLIB_MAJOR_VERSION=1
 GLIB_MINOR_VERSION=2
-GLIB_MICRO_VERSION=10
+GLIB_MICRO_VERSION=23
 GLIB_INTERFACE_AGE=10
 GLIB_BINARY_AGE=10
 GLIB_VERSION=$GLIB_MAJOR_VERSION.$GLIB_MINOR_VERSION.$GLIB_MICRO_VERSION
@@ -2098,7 +2098,7 @@
 echo "configure:2099: checking for extra flags to get ANSI library prototypes" >&5
 glib_save_LIBS=$LIBS
 LIBS="$LIBS -lm"
-if test "$cross_compiling" = yes; then
+if false; then
     { echo "configure: error: can not run test program while cross compiling" 1>&2; exit 1; }
 else
   cat > conftest.$ac_ext <<EOF
@@ -2116,7 +2116,7 @@
   rm -fr conftest*
   glib_save_CFLAGS=$CFLAGS
      CFLAGS="$CFLAGS -std1"
-     if test "$cross_compiling" = yes; then
+     if false; then
     { echo "configure: error: can not run test program while cross compiling" 1>&2; exit 1; }
