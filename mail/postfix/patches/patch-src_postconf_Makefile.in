$NetBSD$

main.cf.default's command as POSTCONF_DEFAULTS, which a cross build replaces
(it cannot run postconf -d).

--- src/postconf/Makefile.in.orig
+++ src/postconf/Makefile.in
@@ -35,11 +35,14 @@
 $(PROG): $(OBJS) $(LIBS)
 	$(CC) $(CFLAGS) $(SHLIB_RPATH) -o $@ $(OBJS) $(LIBS) $(SYSLIBS)
 
+# The defaults: postconf -d (a cross build, which cannot run it, says so).
+POSTCONF_DEFAULTS = $(SHLIB_ENV) $(VALGRIND) ./$(PROG) -d -c ../../conf
+
 ../../conf/main.cf.default: $(PROG) Makefile
 	rm -f $@
 	(echo "# DO NOT EDIT THIS FILE. EDIT THE MAIN.CF FILE INSTEAD. THE"; \
 	 echo "# TEXT HERE JUST SHOWS DEFAULT SETTINGS BUILT INTO POSTFIX."; \
-	 echo "#"; $(SHLIB_ENV) $(VALGRIND) ./$(PROG) -d -c ../../conf) | \
+	 echo "#"; $(POSTCONF_DEFAULTS)) | \
 	    grep -E -v '^(myhostname|mydomain|mynetworks|process_name|process_id) ' >$@
 
 $(OBJS): ../../conf/makedefs.out
